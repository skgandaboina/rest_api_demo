<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.sai</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>demo</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<!--spring-boot-starter-web includes everything needed to build a web application using Spring MVC.
		It pulls in dependencies like: Spring MVC, Jackson for JSON binding,
		Tomcat as the default embedded container,Validation APIs-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!--This starter packs all the major testing libraries you typically use with Spring Boot:
		JUnit 5 (Jupiter) – for writing unit and integration tests,
		Mockito – for mocking dependencies,
		Spring TestContext Framework – to test Spring components with context loading,
		AssertJ – fluent assertions,
		Hamcrest – matcher-based assertions,
		JSONassert and JsonPath – for testing JSON output,
		MockMvc – for testing web layer without starting the server,

		scope>test</scope> This ensures the dependency is only included during testing and not in production builds.-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Boot JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- MySQL Connector -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<scope>runtime</scope>
			<version>8.0.33</version>
		</dependency>

		<!--Use Lombok to reduce boilerplate:-->
		<!--<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>-->

		<!--This Maven dependency brings in Apache Tomcat as an embedded servlet container for your Spring Boot application
		Tomcat is already included by default when you use: <artifactId>spring-boot-starter-web</artifactId>
		So, in most cases, you don’t need to declare it manually unless:
		You're customizing the Tomcat version or configuration
		You're excluding it to use a different server (e.g., Jetty or Undertow) and now want it back
		You're building a WAR for deployment to an external Tomcat server instead of using the embedded one
		When to explicitly include it:
		Customizing the embedded container’s behavior (e.g., adding extra config or listeners)
		Overriding the default version of Tomcat used by Spring Boot
		Note:
		If you're building a WAR for deployment to an external Tomcat (not embedded), you'd usually change the scope to provided-->
		<!--<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>compile</scope>
		</dependency>-->

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
